    function makeFolder(directory) { if (!directory.exists) { if (!directory.parent.exists) { makeFolder(directory.parent); } if (!directory.create()) { fail('E_EXPORT_WRITE', '无法创建导出目录。'); } } }
    function writeJSON(file, value) {
