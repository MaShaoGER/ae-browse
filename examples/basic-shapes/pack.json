    "id": "local.aebrowse.basics",
    "version": "0.1.0",
    "name": "基础图形库",
    "author": "AE Browse",
    "description": "圆角卡片、圆形、椭圆、三角形、六边形和星形。",
    "license": "示例内容允许复制及修改"
  },
  "assets": [
    {
      "id": "rounded-card",
      "name": "圆角卡片",
      "kind": "ae.nativeShape",
      "source": "assets/rounded-card.json",
      "tags": [
        "卡片",
        "背景"
      ],
      "requirements": {
        "aeMin": "26.0",
        "capabilities": [
          "shape.create",
          "animation.keyframes",
          "effect.add"
        ]
      },
      "parameters": [
        {
          "id": "width",
          "label": "宽度",
          "type": "number",
          "default": 320,
          "min": 1,
          "max": 4096,
          "unit": "px",
          "help": "以图形中心为基准调整宽度。"
        },
        {
          "id": "height",
          "label": "高度",
          "type": "number",
          "default": 180,
          "min": 1,
          "max": 4096,
          "unit": "px"
        },
        {
          "id": "radius",
          "label": "圆角",
          "type": "number",
          "default": 24,
          "min": 0,
          "max": 90,
          "unit": "px"
        },
        {
          "id": "color",
          "label": "颜色",
          "type": "color",
          "default": [
            0.2,
            0.5,
            1,
            1
          ]
        },
        {
          "id": "duration",
          "label": "入场时长",
          "type": "number",
          "default": 0.6,
          "min": 0.01,
          "max": 10,
          "unit": "s"
        },
        {
          "id": "motion",
          "label": "入场动画",
          "type": "enum",
          "default": "pop",
          "options": [
            "none",
            "pop",
            "slide",
            "fade"
          ]
        }
      ],
      "effects": [],
      "help": {
        "summary": "调整尺寸、圆角、颜色及入场动画后添加到当前合成。"
      },
      "extensions": {
        "local.aebrowse": {
          "category": "基础图形",
          "previewShape": "rectangle"
        }
      }
    },
