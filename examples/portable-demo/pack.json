{
  "schemaVersion": 1,
  "pack": {
    "id": "local.motion.basics",
    "version": "0.1.0",
    "name": "可复制图形库示例",
    "author": "AE Browse",
    "description": "数据格式样例：圆角卡片、状态、动画和可选效果。",
    "license": "示例内容允许复制及修改"
  },
  "assets": [
    {
      "id": "rounded-card",
      "name": "圆角卡片",
      "kind": "ae.nativeShape",
      "source": "assets/rounded-card.json",
      "tags": ["卡片", "背景"],
      "requirements": {
        "aeMin": "26.0",
        "capabilities": ["shape.create", "animation.keyframes", "effect.add"]
      },
      "parameters": [
        { "id": "width", "label": "宽度", "type": "number", "default": 320, "min": 1, "max": 4096, "unit": "px", "help": "以图形中心为基准调整宽度。" },
        { "id": "height", "label": "高度", "type": "number", "default": 180, "min": 1, "max": 4096, "unit": "px" },
        { "id": "radius", "label": "圆角", "type": "number", "default": 24, "min": 0, "max": 90, "unit": "px" },
        { "id": "color", "label": "颜色", "type": "color", "default": [0.2, 0.5, 1, 1] },
        { "id": "duration", "label": "入场时长", "type": "number", "default": 0.6, "min": 0.01, "max": 10, "unit": "s" },
        { "id": "motion", "label": "入场动画", "type": "enum", "default": "pop", "options": ["none", "pop", "slide", "fade"] }
      ],
      "effects": [
        {
          "id": "soften",
          "matchName": "ADBE Gaussian Blur 2",
          "required": false,
          "target": "output",
          "settings": [],
          "help": "可选高斯模糊；参数映射需要宿主适配器实际验证。"
        }
      ],
      "help": {
        "summary": "调整外观与动画后添加到当前合成。",
        "steps": ["打开目标合成", "调整外观和动画", "添加新图形"],
        "troubleshooting": [
          { "code": "E_NO_ACTIVE_COMP", "tip": "请先打开一个合成；图形库仍可浏览。" },
          { "code": "W_EFFECT_MISSING", "tip": "可选择跳过模糊，保留基本图形。" }
        ]
      },
      "extensions": { "local.motion.basics": { "category": "基础图形" } }
    }
  ]
}
